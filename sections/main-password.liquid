<section class="password iri-band" data-iridescence-host>
  <div class="iridescence" data-iridescence data-color="#F2D2BC" data-speed="0.5" aria-hidden="true"><canvas></canvas></div>
  <div class="iri-band__fallback" aria-hidden="true"></div>
  <div class="container container--narrow iri-band__inner">
    <p class="wordmark wordmark--xl">{{ shop.name | downcase }}</p>
    <h1 class="h2">{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}<p class="iri-band__text">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'storefront_password', class: 'password__form' -%}
      {%- if form.errors -%}<p class="form-error">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="field-pill">
        <label class="visually-hidden" for="Password">{{ 'password.password' | t }}</label>
        <input type="password" name="password" id="Password" autocomplete="current-password" placeholder="{{ 'password.password' | t }}" required>
        <button type="submit" class="shine-btn">{{ 'password.submit' | t }}{% render 'icon', icon: 'arrow-circle' %}</button>
      </div>
    {%- endform -%}
    <p class="password__admin">{{ 'password.owner' | t }} <a href="/admin">{{ 'password.login' | t }}</a></p>
  </div>
</section>

{% schema %}
{
  "name": "Password",
  "class": "section-password",
  "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Skincare, distilled. Opening soon." } ]
}
{% endschema %}
