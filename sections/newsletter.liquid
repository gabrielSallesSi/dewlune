<section class="newsletter">
  <div class="newsletter__media" aria-hidden="true">
    {% render 'media', image: section.settings.image, url: section.settings.image_url, alt: '', sizes: '100vw' %}
  </div>
  <div class="container container--narrow newsletter__inner">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="h1"><span class="blur-text" data-blur-text data-on-view>{{ section.settings.heading }}</span></h2>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    {%- form 'customer', id: 'NewsletterForm', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="form-success" role="status">{% render 'icon', icon: 'check' %} {{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <div class="field-pill">
          <label class="visually-hidden" for="NewsletterEmail">{{ 'newsletter.email' | t }}</label>
          <input id="NewsletterEmail" type="email" name="contact[email]" autocomplete="email" required placeholder="{{ 'newsletter.email' | t }}">
          <button type="submit" class="shine-btn">{{ 'newsletter.subscribe' | t }}{% render 'icon', icon: 'arrow-circle' %}</button>
        </div>
        {%- if form.errors -%}<p class="form-error">{{ form.errors | default_errors }}</p>{%- endif -%}
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "class": "section-newsletter",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "image_url", "label": "Or Unsplash link", "default": "https://images.unsplash.com/photo-1578583316094-043603e4386c" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Dewlune letter" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Notes on skin, twice a month" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Ingredient deep dives, refill reminders and first access to new formulas. No daily emails." }
  ],
  "presets": [ { "name": "Newsletter" } ]
}
{% endschema %}
