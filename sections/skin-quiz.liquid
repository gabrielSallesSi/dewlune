{%- liquid
  assign total = section.blocks.size | plus: 1
  assign icons = 'drop,sun,leaf,moon,refill,check' | split: ','
-%}
<section class="quiz" data-quiz data-quiz-index="0" data-iridescence-host>
  <div class="iridescence" data-iridescence data-color="{{ section.settings.tint }}" data-speed="0.45" aria-hidden="true"><canvas></canvas></div>
  <div class="iri-band__fallback" aria-hidden="true"></div>

  <div class="container quiz__inner">
    <header class="quiz__head">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="h1"><span class="blur-text" data-blur-text>{{ section.settings.heading }}</span></h1>
      <p class="quiz__intro">{{ section.settings.intro | default: "A few thoughtful questions help us shape a routine around your skin and your day. There are no wrong answers." }}</p>
    </header>

    <div class="quiz__layout">
      <aside class="quiz__showcase" aria-label="Dewlune product previews">
        <div class="quiz__image-stack" aria-hidden="true">
          <figure class="quiz__image-card is-active" data-quiz-card="0"><img src="{{ 'dewlune-amber-glow-serum.webp' | asset_url }}" width="1122" height="1402" loading="eager" alt=""></figure>
          <figure class="quiz__image-card" data-quiz-card="1"><img src="{{ 'dewlune-cloud-cream.webp' | asset_url }}" width="1122" height="1402" loading="lazy" alt=""></figure>
          <figure class="quiz__image-card" data-quiz-card="2"><img src="{{ 'dewlune-daily-veil-spf-30.webp' | asset_url }}" width="1122" height="1402" loading="lazy" alt=""></figure>
          <figure class="quiz__image-card" data-quiz-card="3"><img src="{{ 'dewlune-the-daily-ritual-set.webp' | asset_url }}" width="1122" height="1402" loading="lazy" alt=""></figure>
        </div>
        <div class="quiz__showcase-copy">
          <p class="eyebrow">Dewlune, made personal</p>
          <h2 class="h3">A ritual that starts with you.</h2>
          <p data-quiz-guidance>Let’s start with how your skin feels, not a list of rules.</p>
          <span class="quiz__duration">4 questions <span aria-hidden="true">·</span> about 1 minute</span>
          <div class="quiz__profile" aria-live="polite">
            <p class="quiz__profile-label">{{ section.settings.profile_label }}</p>
            <ul class="quiz__profile-chips" role="list" data-quiz-profile></ul>
          </div>
        </div>
      </aside>

      <div class="stepper" data-stepper>
      <div class="quiz-meter" aria-hidden="true"><span class="quiz-meter__fill" data-quiz-meter></span><span class="quiz-meter__glow"></span></div>
      <p class="stepper__progress" aria-live="polite" data-step-status>{{ 'quiz.step_of' | t: step: 1, total: section.blocks.size }}</p>
      <ol class="stepper__indicators" role="list">
        {%- for i in (1..total) -%}
          <li class="stepper__indicator{% if forloop.first %} is-active{% endif %}" data-indicator>
            <button class="stepper__dot" type="button" data-step-jump="{{ forloop.index0 }}" aria-label="{{ 'quiz.step_of' | t: step: i, total: total }}" disabled>
              <span class="stepper__num">{{ i }}</span>
              <svg class="stepper__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12.5 9.5 17 19 7.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            {%- unless forloop.last -%}<span class="stepper__connector"><span></span></span>{%- endunless -%}
          </li>
        {%- endfor -%}
      </ol>
      <div class="stepper__viewport" data-stepper-viewport>
        {%- for block in section.blocks -%}
          {%- assign lines = block.settings.answers | newline_to_br | split: '<br />' -%}
          {%- assign q_index = forloop.index -%}
          <fieldset class="stepper__step{% if forloop.first %} is-active{% endif %}" data-step {{ block.shopify_attributes }}>
            <legend class="quiz__q">{{ block.settings.question }}</legend>
            {%- if block.settings.hint != blank -%}<p class="quiz__hint">{{ block.settings.hint }}</p>{%- endif -%}
            <div class="answers">
              {%- for line in lines -%}
                {%- assign pair = line | split: '=' -%}
                {%- assign label = pair[0] | strip -%}
                {%- assign tags = pair[1] | strip -%}
                {%- if label != blank -%}
                  {%- assign icon_index = forloop.index0 | modulo: icons.size -%}
                  <label class="answer" style="--i: {{ forloop.index0 }}">
                    <input class="answer__input" type="radio" name="q{{ q_index }}" value="{{ tags | escape }}" data-answer>
                    <span class="answer__tile" data-tilt>
                      <span class="answer__key" aria-hidden="true">{{ forloop.index }}</span>
                      <span class="answer__check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12.5 9.5 17 19 7.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                      <span class="answer__icon">{% render 'icon', icon: icons[icon_index] %}</span>
                      <span class="answer__label">{{ label }}</span>
                    </span>
                  </label>
                {%- endif -%}
              {%- endfor -%}
            </div>
            <p class="quiz__reaction" data-quiz-reaction aria-live="polite"></p>
          </fieldset>
        {%- endfor -%}

        <div class="quiz__analyzing" data-quiz-analyzing hidden>
          <div class="quiz__orb" aria-hidden="true"><span></span><span></span><span></span></div>
          <p class="quiz__analyzing-text" data-quiz-analyzing-text>{{ section.settings.analyzing_1 }}</p>
        </div>
        <div class="stepper__step quiz__result" data-step data-result>
          <p class="eyebrow">{{ section.settings.result_eyebrow }}</p>
          <h2 class="h2 quiz__result-title" data-result-title>{{ section.settings.result_heading }}</h2>
          <p class="quiz__hint" data-result-summary></p>
          <ol class="routine-list" role="list" data-result-list></ol>
          <div class="quiz__result-actions">
            <p class="quiz__total"><span>{{ section.settings.total_label }}</span> <strong data-result-total></strong></p>
            <button type="button" class="shine-btn" data-quiz-add>
              {{ 'quiz.add_routine' | t }}
              {% render 'icon', icon: 'arrow-circle' %}
              <span class="dots-loader" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
            </button>
          </div>
        </div>
      </div>

      <div class="stepper__footer">
        <button type="button" class="stepper__back" data-stepper-back hidden>{{ 'quiz.back' | t }}</button>
        <button type="button" class="stepper__next" data-stepper-next disabled data-label-next="{{ 'quiz.continue' | t }}" data-label-last="{{ 'quiz.see_results' | t }}" data-label-restart="{{ 'quiz.restart' | t }}">{{ 'quiz.continue' | t }}</button>
      </div>
      </div>
    </div>
  </div>

  <canvas class="quiz__confetti" data-quiz-confetti aria-hidden="true"></canvas>
  <script type="application/json" data-quiz-products>
    [
      {%- for p in collections.all.products limit: 50 -%}
        {%- assign v = p.selected_or_first_available_variant -%}
        {%- capture quiz_product_image -%}{% render 'branded-product-image', product: p, output: 'url', width: 400 %}{%- endcapture -%}
        {
          "title": {{ p.title | json }},
          "vendor": {{ p.vendor | json }},
          "url": {{ p.url | json }},
          "type": {{ p.type | json }},
          "variant": {{ v.id }},
          "available": {{ v.available | json }},
          "price": {{ v.price }},
          "priceLabel": {{ v.price | money | json }},
          "image": {% if quiz_product_image != blank %}{{ quiz_product_image | strip | json }}{% else %}null{% endif %},
          "tags": {{ p.tags | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
  <script type="application/json" data-quiz-config>
    {
      "steps": {{ section.settings.step_order | split: ',' | json }},
      "money": {{ shop.money_format | json }},
      "summary": {{ section.settings.result_summary | json }},
      "analyzing": [{{ section.settings.analyzing_1 | json }}, {{ section.settings.analyzing_2 | json }}, {{ section.settings.analyzing_3 | json }}],
      "match": {{ section.settings.match_label | json }}
    }
  </script>
</section>

{% schema %}
{
  "name": "Skin quiz",
  "class": "section-quiz",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Skin quiz" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Let us build your routine" },
    { "type": "textarea", "id": "intro", "label": "Introduction", "default": "A few thoughtful questions help us shape a routine around your skin and your day. There are no wrong answers." },
    { "type": "color", "id": "tint", "label": "Shader tint", "default": "#F3D7C3" },
    { "type": "text", "id": "step_order", "label": "Routine order", "info": "Product step tags, in the order they are applied.", "default": "cleanse,treat,serum,moisturize,protect" },
    { "type": "text", "id": "result_eyebrow", "label": "Result eyebrow", "default": "Your routine" },
    { "type": "text", "id": "result_heading", "label": "Result heading", "default": "Made for how your skin behaves" },
    { "type": "text", "id": "result_summary", "label": "Result summary", "info": "[count] is replaced by the number of steps.", "default": "[count] steps, chosen from your answers. Tick them off as you go." },
    { "type": "text", "id": "total_label", "label": "Total label", "default": "Routine total" },
    { "type": "text", "id": "profile_label", "label": "Skin profile label", "default": "Your skin profile" },
    { "type": "text", "id": "analyzing_1", "label": "Analyzing message 1", "default": "Reading your answers" },
    { "type": "text", "id": "analyzing_2", "label": "Analyzing message 2", "default": "Matching seven formulas" },
    { "type": "text", "id": "analyzing_3", "label": "Analyzing message 3", "default": "Building your ritual" },
    { "type": "text", "id": "match_label", "label": "Match label", "default": "match" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How does your skin feel by midday?" },
        { "type": "text", "id": "hint", "label": "Hint", "default": "Pick the closest match." },
        {
          "type": "textarea",
          "id": "answers",
          "label": "Answers",
          "info": "One per line: Label = tags. Tags match product tags, for example skin:dry concern:dryness. Use routine:minimal or routine:full to set the routine length.",
          "default": "Tight and dry = skin:dry concern:dryness\nShiny in the T-zone = skin:combination\nShiny all over = skin:oily\nComfortable = skin:normal\nEasily irritated = skin:sensitive concern:redness"
        }
      ]
    }
  ],
  "presets": [ { "name": "Skin quiz", "blocks": [ { "type": "question" } ] } ]
}
{% endschema %}
