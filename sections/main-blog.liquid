<section class="section">
  <div class="container">
    <h1 class="h1"><span class="blur-text" data-blur-text>{{ blog.title }}</span></h1>
    {%- paginate blog.articles by 9 -%}
      <ul class="article-grid" role="list">
        {%- for article in blog.articles -%}
          <li class="article-card" data-reveal style="--i: {{ forloop.index0 | modulo: 3 }}">
            <a href="{{ article.url }}">
              <div class="article-card__media">
                {%- if article.image -%}
                  {{ article.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '480, 800, 1200', sizes: '(min-width: 990px) 33vw, 100vw' }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              <p class="eyebrow">{{ article.published_at | time_tag: format: 'date' }}</p>
              <h2 class="h3">{{ article.title }}</h2>
              <p>{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
            </a>
          </li>
        {%- endfor -%}
      </ul>
      {%- if paginate.pages > 1 -%}<nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Blog", "class": "section-main-blog", "settings": [] }
{% endschema %}
