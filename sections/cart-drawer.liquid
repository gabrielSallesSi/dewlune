{%- liquid
  assign threshold = settings.free_shipping_threshold | times: 100
  assign remaining = threshold | minus: cart.total_price
  assign progress = 0
  if threshold > 0
    assign progress = cart.total_price | times: 100 | divided_by: threshold
    if progress > 100
      assign progress = 100
    endif
  endif
-%}
<div class="drawer drawer--right cart-drawer" id="CartDrawer" data-drawer data-cart-drawer aria-hidden="true">
  <div class="drawer__overlay" data-drawer-close></div>
  <div class="drawer__panel" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle" tabindex="-1">
    <div class="drawer__head">
      <h2 id="CartDrawerTitle" class="cart-drawer__title">{{ 'cart.title' | t }} <sup data-cart-count>{{ cart.item_count }}</sup></h2>
      <button class="icon-btn" type="button" data-drawer-close>{% render 'icon', icon: 'close' %}<span class="visually-hidden">{{ 'general.close' | t }}</span></button>
    </div>

    {%- if threshold > 0 and cart.item_count > 0 -%}
      <div class="ship-bar" style="--p: {{ progress }}%">
        <p>
          {%- if remaining > 0 -%}
            {%- assign remaining_money = remaining | money -%}
            {% render 'icon', icon: 'truck' %} {{ 'cart.free_shipping_remaining' | t: amount: remaining_money }}
          {%- else -%}
            {% render 'icon', icon: 'check' %} {{ 'cart.free_shipping_unlocked' | t }}
          {%- endif -%}
        </p>
        <div class="ship-bar__track" aria-hidden="true"><span></span></div>
      </div>
    {%- endif -%}

    <div class="cart-drawer__body">
      {%- if cart.item_count > 0 -%}
        <ul class="cart-items" role="list">
          {%- for item in cart.items -%}
            <li class="cart-item" data-line="{{ forloop.index }}" style="--i: {{ forloop.index }}">
              <a href="{{ item.url }}" class="cart-item__media">
                {%- if item.image -%}
                  {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.product.title }}
                {%- endif -%}
              </a>
              <div class="cart-item__info">
                <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="cart-item__variant">{{ item.variant.title }}</p>
                {%- endunless -%}
                {%- if item.selling_plan_allocation -%}
                  <p class="cart-item__variant">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                {%- endif -%}
                {%- for discount in item.line_level_discount_allocations -%}
                  <p class="cart-item__discount">{{ discount.discount_application.title }} (-{{ discount.amount | money }})</p>
                {%- endfor -%}
                <div class="cart-item__row">
                  <div class="qty" data-qty>
                    <button type="button" data-qty-change="{{ item.quantity | minus: 1 }}" data-line-index="{{ forloop.index }}" aria-label="{{ 'products.quantity' | t }} -1">{% render 'icon', icon: 'minus' %}</button>
                    <span aria-live="polite">{{ item.quantity }}</span>
                    <button type="button" data-qty-change="{{ item.quantity | plus: 1 }}" data-line-index="{{ forloop.index }}" aria-label="{{ 'products.quantity' | t }} +1">{% render 'icon', icon: 'plus' %}</button>
                  </div>
                  <div class="cart-item__price">
                    {%- if item.original_line_price > item.final_line_price -%}
                      <s>{{ item.original_line_price | money }}</s>
                    {%- endif -%}
                    <span>{{ item.final_line_price | money }}</span>
                  </div>
                </div>
                <button type="button" class="cart-item__remove" data-qty-change="0" data-line-index="{{ forloop.index }}">{{ 'cart.remove' | t }}</button>
              </div>
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <div class="cart-empty">
          <span class="cart-empty__icon">{% render 'icon', icon: 'drop' %}</span>
          <p>{{ 'cart.empty' | t }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="hover-btn">
            <span class="hover-btn__dot" aria-hidden="true"></span>
            <span class="hover-btn__label">{{ 'cart.continue' | t }}</span>
            <span class="hover-btn__reveal" aria-hidden="true">{{ 'cart.continue' | t }}{% render 'icon', icon: 'arrow' %}</span>
          </a>
        </div>
      {%- endif -%}
    </div>

    {%- if cart.item_count > 0 -%}
      <div class="cart-drawer__foot">
        {%- if cart.item_count >= 3 and settings.ritual_discount_note != blank -%}
          <p class="ritual-note">{% render 'icon', icon: 'leaf' %} {{ settings.ritual_discount_note }}</p>
        {%- endif -%}
        {%- for discount in cart.cart_level_discount_applications -%}
          <p class="cart-drawer__line"><span>{{ discount.title }}</span><span>-{{ discount.total_allocated_amount | money }}</span></p>
        {%- endfor -%}
        <p class="cart-drawer__line cart-drawer__total"><span>{{ 'cart.subtotal' | t }}</span><span>{{ cart.total_price | money_with_currency }}</span></p>
        <p class="cart-drawer__fine">{{ 'cart.taxes' | t }}</p>
        <form action="{{ routes.cart_url }}" method="post">
          <button type="submit" name="checkout" class="shine-btn shine-btn--block">
            {{ 'cart.checkout' | t }}
            {% render 'icon', icon: 'arrow-circle' %}
          </button>
        </form>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Cart drawer",
  "settings": []
}
{% endschema %}
