<section class="section recs" data-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="container">
      <div class="section-head">
        <h2 class="h2">{{ section.settings.heading }}</h2>
      </div>
      <ul class="product-grid product-grid--4" role="list">
        {%- for rec in recommendations.products -%}
          <li class="product-grid__item" style="--i: {{ forloop.index0 }}">{% render 'product-card', product: rec %}</li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Product recommendations",
  "class": "section-recs",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pairs well with" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 8, "step": 1, "default": 4 }
  ]
}
{% endschema %}
