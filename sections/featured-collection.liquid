{%- liquid
  assign collection = section.settings.collection
  if collection == blank
    assign collection = collections.all
  endif
  assign concerns = ''
  for product in collection.products limit: section.settings.limit
    for tag in product.tags
      if tag contains 'concern:'
        assign c = tag | remove_first: 'concern:'
        assign concerns = concerns | append: c | append: ','
      endif
    endfor
  endfor
  assign concern_list = concerns | split: ',' | uniq
-%}
<section class="section featured" data-filter-scope>
  <div class="container">
    <div class="section-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h2"><span class="blur-text" data-blur-text data-on-view>{{ section.settings.heading }}</span></h2>
      </div>
      {%- if section.settings.show_filters and concern_list.size > 1 -%}
        <div class="chips" role="group" aria-label="{{ 'collections.filter' | t }}">
          <button type="button" class="chip is-active" data-concern-filter="all" aria-pressed="true">{{ 'collections.all_concerns' | t }}</button>
          {%- for c in concern_list -%}
            <button type="button" class="chip" data-concern-filter="{{ c }}" aria-pressed="false">{{ c | replace: '-', ' ' }}</button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- if collection.products_count > 0 -%}
      <ul class="product-grid" role="list">
        {%- for product in collection.products limit: section.settings.limit -%}
          <li class="product-grid__item" style="--i: {{ forloop.index0 }}" data-reveal>
            {% render 'product-card', product: product %}
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <ul class="product-grid" role="list">
        {%- for i in (1..4) -%}
          <li class="product-grid__item">
            <div class="card card--placeholder">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.link_label != blank -%}
      <div class="section-foot">
        <a href="{{ collection.url | default: routes.all_products_collection_url }}" class="hover-btn">
          <span class="hover-btn__dot" aria-hidden="true"></span>
          <span class="hover-btn__label">{{ section.settings.link_label }}</span>
          <span class="hover-btn__reveal" aria-hidden="true">{{ section.settings.link_label }}{% render 'icon', icon: 'arrow' %}</span>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "class": "section-featured",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The edit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Six formulas, nothing filler" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "show_filters", "label": "Show concern filters", "info": "Built from product tags like concern:dryness.", "default": true },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop everything" }
  ],
  "presets": [ { "name": "Featured collection" } ]
}
{% endschema %}
