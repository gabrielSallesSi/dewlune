<section class="section rich">
  <div class="container container--narrow rich__inner">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="h2"><span class="blur-text" data-blur-text data-on-view>{{ section.settings.heading }}</span></h2>{%- endif -%}
    <div class="rte">{{ section.settings.text }}</div>
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "class": "section-rich",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Talk about your brand" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Share information about your brand.</p>" }
  ],
  "presets": [ { "name": "Rich text" } ]
}
{% endschema %}
