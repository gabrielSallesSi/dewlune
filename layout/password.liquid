<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    <style>
      @font-face { font-family: 'Fraunces'; src: url('{{ 'fraunces.woff2' | asset_url }}') format('woff2'); font-weight: 100 900; font-display: swap; }
      @font-face { font-family: 'Manrope'; src: url('{{ 'manrope.woff2' | asset_url }}') format('woff2'); font-weight: 200 800; font-display: swap; }
      :root {
        --c-bg: {{ settings.color_background }}; --c-surface: {{ settings.color_surface }}; --c-ink: {{ settings.color_ink }};
        --c-muted: {{ settings.color_muted }}; --c-accent: {{ settings.color_accent }}; --c-peach: {{ settings.color_accent_soft }};
        --c-sage: {{ settings.color_sage }}; --c-line: {{ settings.color_line }};
        --c-ink-rgb: {{ settings.color_ink.red }}, {{ settings.color_ink.green }}, {{ settings.color_ink.blue }};
        --c-accent-rgb: {{ settings.color_accent.red }}, {{ settings.color_accent.green }}, {{ settings.color_accent.blue }};
      }
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'effects.css' | asset_url | stylesheet_tag }}
    {{ 'chrome.css' | asset_url | stylesheet_tag }}
    <script>document.documentElement.classList.replace('no-js','js'); window.Dewlune = { motion: true, webgl: true, routes: {}, strings: {} };</script>
    <script src="{{ 'effects.js' | asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body class="template-password">
    <main id="MainContent">{{ content_for_layout }}</main>
  </body>
</html>
