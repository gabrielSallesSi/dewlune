{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ 'gift_cards.title' | t }} &ndash; {{ shop.name }}</title>
    <style>
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: {{ settings.color_background }}; color: {{ settings.color_ink }}; font-family: system-ui, sans-serif; }
      .gc { background: {{ settings.color_surface }}; border-radius: 24px; padding: 48px; max-width: 420px; text-align: center; box-shadow: 0 30px 60px -30px rgba(0,0,0,.25); }
      .gc h1 { font-family: Georgia, serif; font-weight: 400; }
      .gc code { display: block; font-size: 1.4rem; letter-spacing: .1em; margin: 16px 0; }
      .gc a, .gc button { color: inherit; }
    </style>
    {{ content_for_header }}
  </head>
  <body>
    <div class="gc">
      <p>{{ shop.name }}</p>
      <h1>{{ gift_card.initial_value | money }}</h1>
      <p>{{ 'gift_cards.balance' | t }}: {{ gift_card.balance | money }}</p>
      <p>{{ 'gift_cards.code' | t }}</p>
      <code>{{ gift_card.code | format_code }}</code>
      {%- if gift_card.pass_url -%}<p><a href="{{ gift_card.pass_url }}">Apple Wallet</a></p>{%- endif -%}
      <button type="button" onclick="window.print()">{{ 'gift_cards.print' | t }}</button>
    </div>
  </body>
</html>
