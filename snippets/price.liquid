{%- comment -%}
  - product: product object
  - variant: optional variant (defaults to selected or first available)
  - show_from: show "From" when variants have different prices
{%- endcomment -%}
{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  assign price = target.price
  assign compare = target.compare_at_price
  assign on_sale = false
  if compare > price
    assign on_sale = true
  endif
-%}
<div class="price{% if on_sale %} price--sale{% endif %}" data-price>
  {%- if show_from and product.price_varies -%}
    {%- assign from_price = product.price_min | money -%}
    <span class="price__current">{{ 'products.from' | t: price: from_price }}</span>
  {%- else -%}
    <span class="visually-hidden">{% if on_sale %}{{ 'products.sale_price' | t }}{% else %}{{ 'products.regular_price' | t }}{% endif %}</span>
    <span class="price__current">{{ price | money }}</span>
    {%- if on_sale -%}
      <s class="price__compare">{{ compare | money }}</s>
    {%- endif -%}
  {%- endif -%}
</div>
